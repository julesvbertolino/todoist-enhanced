{
  "name": "todoist-enhancements",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "description": "An independent project, not created by, affiliated with, or supported by Todoist. A different front end built around planning a week.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "date-fns": "^4.1.0",
    "emojibase-data": "17.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@codemirror/language": "6.12.4"
  }
}
